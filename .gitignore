# --- Dependencies (npm / yarn / bun / pnpm) ---
node_modules/
.bun/
bun.*
jspm_packages/
typings/
.yarn/
.pnp.*
.yarnrc.yml

# --- Build & tooling output ---
dist/
build/
out/
coverage/
*.tsbuildinfo
.nyc_output/
public/
static/
serverless/
.next/
.angular/cache/

# --- Lockfiles (library projects: not committed) ---
bun.lock
bun.lockb
package-lock.json
yarn.lock
.pnpm-lock.yaml

# --- Logs ---
logs/
*.log
npm-debug.log*
.pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Caches ---
.npm/
.eslintcache
.tmp/
.cache/
# Turborepo task cache (turbo.json itself stays committed)
.turbo/

# --- Environment / secrets (keep examples) ---
.env
.env.*
!.env.example
!.env.sample

# --- Docker: local overrides & state only (keep committed Dockerfiles) ---
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# --- Micro-frontends (Module Federation / single-spa) ---
# Module Federation runtime/build cache and generated remote types
.mf/
.federation*
@mf-types/
# Vite / Module Federation plugin temp files
*.timestamp*

