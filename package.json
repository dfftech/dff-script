  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun run build && bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dff-util": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "^5.9.0"
  }
}