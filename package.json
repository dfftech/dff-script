{
  "name": "dff-script",
  "version": "0.1.1",
  "type": "module",
  "description": "Generate files from sss-hbs templates with Bun",
  "bin": {
    "dff-script": "dist/cli.js"
  },
  "files": ["dist"],
  "packageManager": "bun@1.4.0",
